# Server-only. Copy to .env and fill in the values. Never commit populated env files.
# .env.local is also supported; nonempty values there override .env.
# Shell environment variables override both files, including explicit blank values.

# Required for personalized business-owner PDFs. Learner PDFs do not need Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Brevo transactional EMAIL API key (not an SMTP password).
BREVO_API_KEY=
# Plain email address registered as a sender in Brevo. No display-name brackets here.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Seyi
# Optional reply-to address; leave blank to use the sender address.
BREVO_REPLY_TO_EMAIL=

# Optional Telegram owner alerts. Set both to enable.
# Token from @BotFather; chat ID is your private chat or group ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local development. No need to change these for localhost.
PORT=3000
HOST=127.0.0.1

# Hosted admin identity; must match the platform-authenticated owner's email.
ADMIN_EMAIL=

# Optional live AI acknowledgements. Guided conversation works without these.
OPENAI_API_KEY=
OPENAI_MODEL=
